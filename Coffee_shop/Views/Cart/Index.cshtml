@model Coffee_shop.Models.CartViewModel
@using System.Linq
@{
    Layout = "_MobiriseLayout";
    var items = Model?.Items ?? new List<Coffee_shop.Models.CartViewItem>();
    var totalItems = items.Sum(item => item.Quantity);
    var totalPrice = Model?.GrandTotal ?? 0;
}

<section class="h-100 h-custom">
    <div class="container py-5 h-100">
        <div class="row d-flex justify-content-center align-items-center h-100">
            <div class="col-12">
                <div class="card card-registration card-registration-2" style="border-radius: 15px; background-color:#fafafa">
                    <div class="card-body p-0">
                        <div class="row g-0">
                            <div class="col-lg-7">
                                <div class="p-5">
                                    <div class="d-flex justify-content-between align-items-center mb-5">
                                        <h2 class="fw-bold mb-0 text-black">Shopping Cart</h2>
                                        <h6 class="mb-0 text-muted">@totalItems item@(totalItems == 1 ? string.Empty : "s")</h6>
                                    </div>
                                    <hr class="my-4">

                                    @foreach (var item in items)
                                    {
                                        <div class="row mb-4 d-flex justify-content-between align-items-center">
                                            <div class="col-md-2 col-lg-2 col-xl-2">
                                                <img src="@(item.Product?.ImageUrl ?? "/assets/images/jeremy-yap-jn-hagwe4yw-unsplash-815x1223.jpg")"
                                                     class="img-fluid rounded-3"
                                                     alt="@item.Product?.Name">
                                            </div>
                                            <div class="col-md-3 col-lg-3 col-xl-3">
                                                <h6 class="text-black mb-0">@item.Quantity x @item.Product?.Name</h6>
                                                <small class="text-muted">@item.Product?.Description</small>
                                            </div>

                                            <div class="col-md-3 col-lg-2 col-xl-2 offset-lg-1">
                                                <h6 class="mb-0">@item.Product?.Price.ToString("C0")</h6>
                                            </div>

                                            <div class="col-md-1 col-lg-1 col-xl-1 text-end">
                                                <a class="text-decoration-none text-danger"
                                                   href="@Url.Action("Remove", "Cart", new { id = item.Product?.Id })"
                                                   title="Remove from cart"
                                                   onclick="return confirm('Xóa sản phẩm này khỏi giỏ hàng?')">
                                                    <h3 style="font-size: 2rem; line-height: 1; margin: 0;">&#128465;</h3>
                                                </a>
                                            </div>
                                        </div>

                                        <hr class="my-4">
                                    }

                                    <div class="pt-5">
                                        <h6 class="mb-0">
                                            <a class="text-body text-decoration-none" href="~/Products/Shop">
                                                <i class="fas fa-long-arrow-alt-left me-2"></i>Back to shop
                                            </a>
                                        </h6>
                                    </div>
                                </div>
                            </div>

                            <div class="col-lg-5 bg-grey">
                                <div class="p-5">
                                    <h4 class="fw-bold mb-5 mt-2 pt-1">Summary</h4>
                                    <hr class="my-4">
                                    <div class="d-flex justify-content-between mb-5">
                                        <h5 class="text-uppercase">Total price</h5>
                                        <h5>@totalPrice.ToString("C0")</h5>
                                    </div>

                                    <a href="~/Checkout/Index">
                                        <button type="button"
                                                class="btn btn-primary w-100 text-center"
                                                data-mdb-ripple-color="dark">
                                            Proceed
                                        </button>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
