@model IEnumerable<Coffee_shop.Models.Product>
@{
    ViewData["Title"] = "Home";
    Layout = "_MobiriseLayout";
}

<section data-bs-version="5.1" class="header18 cid-tsEQyIZRcx mbr-fullscreen mbr-parallax-background" id="header18-1">
    <div class="mbr-overlay" style="opacity:0.9; background-image: url('https://images.unsplash.com/photo-1580933073521-dc49ac0d4e6a?auto=format&fit=crop&w=2000&q=80');"></div>
    <div class="mbr-overlay" style="opacity: 0.7; background-color: rgb(0, 0, 0);"></div>
    <div class="align-center container">
        <div class="row justify-content-center">
            <div class="col-12 col-lg-10">
                <h1 class="mbr-section-title mbr-fonts-style mbr-white mb-3 display-1"><strong>The daily grind
                        coffee house</strong></h1>

                <p class="mbr-text mbr-fonts-style mbr-white display-7">Where every cup is a fresh brew of perfection</p>
                <div class="mbr-section-btn mt-3"><a class="btn btn-primary display-4" href="/Products/Shop"><span class="mobi-mbri mobi-mbri-shopping-bag mbr-iconfont mbr-iconfont-btn"></span>Shop now&nbsp;</a></div>
            </div>
        </div>
    </div>
</section>

<section data-bs-version="5.1" class="content2 cid-tsEQSCqggh" id="content2-2">
    <div class="container">
        <div class="mbr-section-head">
            <h4 class="mbr-section-title mbr-fonts-style align-center mb-0 display-2"><strong>Top Selling</strong></h4>
            <h5 class="mbr-section-subtitle mbr-fonts-style align-center mb-0 mt-2 display-5">Make your mornings better with our top-selling product.</h5>
        </div>
        <div class="row mt-4">
            @foreach (var product in Model)
            {
                <div class="item features-image сol-12 col-md-6 col-lg-4">
                    <div class="item-wrapper">
                        <div class="item-img"><img src="@(product.ImageUrl ?? "/assets/images/jeremy-yap-jn-hagwe4yw-unsplash-815x1223.jpg")" alt="@product.Name"></div>
                        <div class="item-content">
                            <h6 class="item-subtitle mbr-fonts-style mt-1 display-7"><strong>@product.Name</strong></h6>
                            <p class="mbr-text mbr-fonts-style mt-3 display-7">@product.Price.ToString("C0")</p>
                        </div>
                        <div class="mbr-section-btn item-footer mt-2 d-flex gap-2">
                            <a href="@Url.Action("Add", "Cart", new { id = product.Id })" class="btn btn-primary item-btn display-4" role="button" aria-pressed="false" title="Add to cart"><span class="mbrib-cart-add mbr-iconfont mbr-iconfont-btn"></span>Add to cart</a>
                            <a href="@Url.Action("Details", "Product", new { id = product.Id })" class="btn btn-outline-secondary display-4" title="View details">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="mb-1 me-1" viewBox="0 0 16 16">
                                    <path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8zM1.173 8a13.133 13.133 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5c2.12 0 3.879 1.168 5.168 2.457A13.133 13.133 0 0 1 14.828 8c-.058.087-.122.183-.195.288-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5c-2.12 0-3.879-1.168-5.168-2.457A13.134 13.134 0 0 1 1.172 8z"/>
                                    <path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5zM4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0z"/>
                                </svg>Details
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>
