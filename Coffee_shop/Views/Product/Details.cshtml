@model Coffee_shop.Models.Product
@{
    ViewData["Title"] = "Detail";
    Layout = "_MobiriseLayout";
}

<div class="container mt-5">
    <div class="card-wrapper">
        <div class="row align-items-center">
            <div class="col-12 col-lg-6">
                <div class="image-wrapper">
                    <img src="@(Model.ImageUrl ?? "/assets/images/jeremy-yap-jn-hagwe4yw-unsplash-815x1223.jpg")" alt="@Model.Name" class="img-fluid">
                </div>
            </div>
            <div class="col-12 col-lg">
                <div class="text-box">
                    <h2 class="mbr-title mbr-fonts-style display-2"><strong>@Model.Name</strong></h2>
                    <p class="mbr-text mbr-fonts-style display-7">@Model.Description</p>
                    <div class="cost"><span class="currentcost mbr-fonts-style pr-2 display-2">@Model.Price.ToString("C0")</span></div>
                    <div class="mbr-section-btn pt-3">
                        <button type="button" class="btn btn-primary display-4 add-to-cart-btn" data-product-id="@Model.Id">
                            <span class="mbrib-cart-add mbr-iconfont mbr-iconfont-btn"></span>Add to cart&nbsp;
                        </button>
                        <a class="btn btn-outline-secondary ms-2" href="@Url.Action("Shop","Product")">Back to shop</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>