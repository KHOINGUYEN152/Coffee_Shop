@model Coffee_shop.Models.Contact
@{
    ViewData["Title"] = "Contact";
    Layout = "_MobiriseLayout";
}

<section data-bs-version="5.1" class="form7 cid-tsJ8wGtENs" id="form7-q">
    <div class="container">
        <div class="mbr-section-head">
            <h3 class="mbr-section-title mbr-fonts-style align-center mb-0 display-2">
                <strong>Get in Touch</strong>
            </h3>
        </div>
        <div class="row justify-content-center mt-3">
            <div class="col-lg-8 mx-auto">
                @if (TempData["ContactSuccess"] != null)
                {
                    <div id="contact-message" class="alert alert-success text-center" role="alert" style="display:block;color:#155724;background-color:#d4edda;border-color:#c3e6cb;padding:12px;font-weight:600;">@TempData["ContactSuccess"]</div>
                }
                else if (TempData["ContactError"] != null)
                {
                    <div id="contact-message" class="alert alert-danger text-center" role="alert" style="display:block;color:#721c24;background-color:#f8d7da;border-color:#f5c6cb;padding:12px;font-weight:600;">@TempData["ContactError"]</div>
                }
            </div>
        </div>
        <div class="row justify-content-center mt-4">
            <div class="col-lg-8 mx-auto mbr-form">
                <form asp-action="Index" asp-controller="Contact" method="post" class="mbr-form form-with-styler mx-auto">
                    @Html.AntiForgeryToken()

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger" role="alert" style="display:block;color:#721c24;background-color:#f8d7da;border-color:#f5c6cb;padding:10px;margin-bottom:1rem;">@Html.ValidationSummary(excludePropertyErrors: true)</div>
                    }
                    <p class="mbr-text mbr-fonts-style align-center mb-4 display-7">
                        One of our team will be in contact with you shortly.
                    </p>

                    <div class="dragArea row">
                        <div class="col-lg-12 col-md-12 col-sm-12 form-group mb-3" data-for="name">
                            <input asp-for="Name" placeholder="Name" data-form-field="name" class="form-control" id="name-form7-q" />
                            <span class="text-danger">@Html.ValidationMessageFor(m => m.Name)</span>
                        </div>
                        <div class="col-lg-12 col-md-12 col-sm-12 form-group mb-3" data-for="email">
                            <input asp-for="Email" placeholder="Email" data-form-field="email" class="form-control" id="email-form7-q" />
                            <span class="text-danger">@Html.ValidationMessageFor(m => m.Email)</span>
                        </div>
                        <div class="col-lg-12 col-md-12 col-sm-12 form-group mb-3" data-for="subject">
                            <input asp-for="Subject" type="text" placeholder="Subject" data-form-field="subject" class="form-control" id="subject-form7-q" />
                            <span class="text-danger">@Html.ValidationMessageFor(m => m.Subject)</span>
                        </div>
                        <div data-for="phone" class="col-lg-12 col-md-12 col-sm-12 form-group mb-3">
                            <textarea asp-for="Message" class="form-control" rows="5" placeholder="Message"></textarea>
                            <span class="text-danger">@Html.ValidationMessageFor(m => m.Message)</span>
                        </div>
                        <div class="col-auto mbr-section-btn align-center">
                            <button type="submit" class="btn btn-primary display-4">Send</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        var m = document.getElementById('contact-message');
        if (m) {
            // ensure visible and scroll into view
            m.style.display = 'block';
            m.scrollIntoView({behavior: 'smooth', block: 'center'});
        }
    });
</script>