@model Coffee_shop.Models.Order
@{
    ViewData["Title"] = "Order Confirmation";
    Layout = "_MobiriseLayout";
}

<section class="container py-5">
    <div class="row">
        <div class="col-md-8 offset-md-2 text-center">
            <h3>Thank you — your order is placed</h3>
            <p>Order number: <strong>@Model.OrderNumber</strong></p>
            <p>Status: <strong>@Model.Status</strong></p>
            <h5>Items</h5>
            <ul class="list-group mb-3">
                @foreach (var item in Model.Items)
                {
                    <li class="list-group-item d-flex justify-content-between lh-sm">
                        <div>
                            <h6 class="my-0">@item.Product?.Name x @item.Quantity</h6>
                            <small class="text-muted">@item.Product?.Description</small>
                        </div>
                        <span class="text-muted">@((item.UnitPrice * item.Quantity).ToString("C0"))</span>
                    </li>
                }
            </ul>
            <p>Total: <strong>@Model.Total.ToString("C0")</strong></p>
        </div>
    </div>
</section>
